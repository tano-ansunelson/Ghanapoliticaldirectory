@model MinistryPageModel
@{
    ViewData["Title"] = Model.MinistryName;
    ViewData["Nav"] = "ministries";
}
@if (Model.Ministries.Count == 0)
{
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("Ministries", null))
    <section class="gpd-section"><div class="container">
        @await Html.PartialAsync("_EmptyState", new EmptyStateModel("bi-archive", "Nothing published yet", "Ministries appear here once they have been verified, approved and published."))
    </div></section>
}
else
{
    @await Html.PartialAsync("_MinistriesBody", Model)
}
