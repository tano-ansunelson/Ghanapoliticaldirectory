@model Ghanapoliticaldirectory.Controllers.LoginForm
@{
    Layout = "_Layout"; ViewData["Title"] = "Sign in";
}
<div class="container my-5" style="max-width:28rem">
    <h1 class="gpd-h1">Sign in</h1>
    <p class="gpd-muted">For editors and reviewers of the directory. Public pages need no account.</p>
    <form method="post" asp-action="Login" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label class="form-label" asp-for="Email">Email</label>
            <input class="form-control" asp-for="Email" type="email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password">Password</label>
            <input class="form-control" asp-for="Password" autocomplete="current-password" />
        </div>
        <button class="btn btn-gpd" type="submit">Sign in</button>
    </form>
</div>
