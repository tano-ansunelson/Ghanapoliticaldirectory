@model MinistriesAdminModel
@{
    ViewData["Title"] = "Ministries"; var f = Model.Form;
}
<div class="gpd-admin-pagehead">
    <div>
        <h1 class="gpd-h1">Ministries</h1>
        <p class="gpd-muted mb-0">Ministries are renamed over time. Every name is kept with the dates it applied, so history stays correct.</p>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <section class="gpd-panel">
            <h2 class="gpd-h3">Add a ministry</h2>
            <form method="post" asp-action="Ministries" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="Name">Name <span class="gpd-req">*</span></label>
                    <input class="form-control" id="Name" name="Name" value="@f.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="NameSince">This name has been used since <span class="gpd-req">*</span></label>
                    <input class="form-control" id="NameSince" name="NameSince" type="date" value="@f.NameSince?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Description">Description</label>
                    <textarea class="form-control" id="Description" name="Description" rows="2">@f.Description</textarea>
                </div>
                <button class="btn btn-gpd" type="submit">Add ministry</button>
            </form>
        </section>
    </div>
    <div class="col-lg-8">
       @*  <section class="gpd-panel"> *@
        <section class="gpd-panel ministries-scroll">
            @if (Model.Rows.Count == 0)
            {
                <p class="gpd-muted mb-0">None yet.</p>
            }
            @foreach (var m in Model.Rows)
            {
                <div class="border-bottom py-3">
                    <h2 class="gpd-h3 mb-1">@m.CurrentName</h2>
                    <ul class="small mb-2">@foreach (var n in m.Names) {
                        <li>@n.Name: @n.From.ToString("d MMM yyyy") – @(n.To?.ToString("d MMM yyyy") ?? "present")</li>
                    }
                </ul>
                <form asp-action="RenameMinistry" asp-route-id="@m.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-md-5"><label class="form-label small" for="nn-@m.Id">New name</label><input class="form-control form-control-sm" id="nn-@m.Id" name="newName" required /></div>
                    <div class="col-md-4"><label class="form-label small" for="ef-@m.Id">Effective from</label><input class="form-control form-control-sm" id="ef-@m.Id" type="date" name="effectiveFrom" required /></div>
                    <div class="col-md-3"><button class="btn btn-sm btn-outline-secondary w-100" type="submit">Rename</button></div>
                </form>
            </div>
        }
    </section>
</div>
</div>
