@model PositionPanelModel
@{
    var k = Model.Key;
    var i = Model.Input;
    var o = Model.Options;

    string Name(string field) => k + "." + field;
    string Id(string field) => "f-" + k + "-" + field;
    string Err(string field) =>
        ViewContext.ModelState.TryGetValue(Name(field), out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : "";
    string D(DateOnly? d) => d is null ? "" : d.Value.ToString("yyyy-MM-dd");

    var isMp = k == "Mp";
    var isMinistry = k is "Minister" or "DeputyMinister";
    var isOther = k == "Other";
    var showAdmin = true;
    var showStatus = !isMp;
    var startLabel = isMinistry ? "Appointment date" : "Start date";
}
<fieldset class="gpd-position-panel" id="panel-@k" data-position-panel="@k" hidden="@(!Model.Open)"
          data-dependent-form="@(isMp ? "true" : null)" data-constituency-url="@Model.ConstituencyUrl">
    <legend>@Model.Label: details</legend>
    <p class="gpd-muted small">Saved as its own record linked to this person. Its dates are independent of every other position.</p>
    <div class="row g-3">

        @if (isOther)
        {
            <div class="col-md-12">
                <label class="form-label" for="@Id("Title")">Position title <span class="gpd-req" aria-hidden="true">*</span></label>
                <input class="form-control" id="@Id("Title")" name="@Name("Title")" value="@i.Title" />
                @if (Err("Title") != "")
                {
                    <div class="invalid-feedback d-block">@Err("Title")</div>
                }
            </div>
        }

        @if (isMp)
        {
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("ElectionCycleId"), "Election cycle or parliamentary term", o.ElectionCycles, i.ElectionCycleId, "Select a cycle", Required: true))
                @if (Err("ElectionCycleId") != "")
                {
                    <div class="invalid-feedback d-block">@Err("ElectionCycleId")</div>
                }
            </div>
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("PartyAtTimeId"), "Party affiliation at the time of the election", o.Parties, i.PartyAtTimeId, "Independent / no party"))
            </div>
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("RegionId"), "Region", o.Regions, i.RegionId, "Select a region", Role: "region"))
            </div>
            <div class="col-md-6">
                <div class="gpd-field">
                    <label class="form-label" for="@Id("ConstituencyId")">Constituency <span class="gpd-req" aria-hidden="true">*</span></label>
                    <select class="form-select" id="@Id("ConstituencyId")" name="@Name("ConstituencyId")" data-role="constituency" data-selected="@i.ConstituencyId"
                            disabled="@(string.IsNullOrEmpty(i.RegionId))">
                        <option value="">@(string.IsNullOrEmpty(i.RegionId) ? "Choose a region first" : "Select a constituency")</option>
                    </select>
                    @if (Err("ConstituencyId") != "")
                    {
                        <div class="invalid-feedback d-block">@Err("ConstituencyId")</div>
                    }
                </div>
            </div>
        }

        @if (showAdmin)
        {
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("AdministrationId"), isOther ? "Administration (if applicable)" : isMp ? "Administration they served under" : "Administration", o.Administrations, i.AdministrationId, "Select an administration", Required: !isOther))
                @if (Err("AdministrationId") != "")
                {
                    <div class="invalid-feedback d-block">@Err("AdministrationId")</div>
                }
            </div>
        }

        @if (isMinistry)
        {
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("MinistryId"), "Ministry", o.Ministries, i.MinistryId, "Select a ministry", Required: true))
                @if (Err("MinistryId") != "")
                {
                    <div class="invalid-feedback d-block">@Err("MinistryId")</div>
                }
            </div>
        }

        <div class="col-md-6 col-lg-3">
            <label class="form-label" for="@Id("Start")">@startLabel <span class="gpd-req" aria-hidden="true">*</span></label>
            <input class="form-control" type="date" id="@Id("Start")" name="@Name("Start")" value="@D(i.Start)" data-start="@k" />
            @if (Err("Start") != "")
            {
                <div class="invalid-feedback d-block">@Err("Start")</div>
            }
        </div>
        <div class="col-md-6 col-lg-3">
            <label class="form-label" for="@Id("End")">End date</label>
            <input class="form-control" type="date" id="@Id("End")" name="@Name("End")" value="@D(i.End)" data-end="@k" aria-describedby="@(Id("End"))-help" />
            <div class="form-text" id="@(Id("End"))-help">Leave empty while the position continues.</div>
            @if (Err("End") != "")
            {
                <div class="invalid-feedback d-block">@Err("End")</div>
            }
        </div>

        @if (showStatus)
        {
            <div class="col-md-6">
                @await Html.PartialAsync("_SelectField", new SelectFieldModel(Name("Status"), "Appointment status", o.AppointmentStatuses, i.Status, "Select a status"))
            </div>
        }

        <div class="col-md-@(showStatus ? "6" : "12")">
            <label class="form-label" for="@Id("Source")">Source (official URL or document)</label>
            <input class="form-control" id="@Id("Source")" name="@Name("Source")" value="@i.Source" placeholder="https://…" />
        </div>
    </div>
</fieldset>

