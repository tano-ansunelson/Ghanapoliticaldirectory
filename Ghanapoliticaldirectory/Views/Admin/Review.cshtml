@model IReadOnlyList<Ghanapoliticaldirectory.Business.ReviewQueueRow>
@using Ghanapoliticaldirectory.Domain
@{
    ViewData["Title"] = "Review queue";
}
<div class="gpd-admin-pagehead">

    <div>
        <h1 class="gpd-h1">Review queue</h1>
        <p class="gpd-muted mb-0">Entry, verification, approval and publication are separate steps. You cannot move on a record you entered yourself.</p>
    </div>

</div>
<div class="gpd-panel">
    @if (Model.Count == 0)
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateModel("bi-check2-all", "Nothing waiting", "No records are waiting for review."))
    }
    else
    {
        <div class="table-responsive">
            <table class="table gpd-table align-middle">
                <caption class="visually-hidden">Records in the review pipeline</caption>
                <thead><tr><th scope="col">Record</th><th scope="col">Type</th><th scope="col">Stage</th><th scope="col">Entered by</th><th scope="col" class="text-end">Next step</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var next = r.Stage switch
                        {
                            WorkflowStage.Draft => (WorkflowAction?)WorkflowAction.Submit,
                            WorkflowStage.AwaitingVerification => WorkflowAction.Verify,
                            WorkflowStage.Verified => WorkflowAction.Approve,
                            WorkflowStage.Approved => WorkflowAction.Publish,
                            _ => null
                        };
                        <tr>
                            <th scope="row">@r.Label</th>
                            <td>@r.Type</td>
                            <td>@r.Stage</td>
                            <td>@r.EnteredBy</td>
                            <td class="text-end">
                                @if (next is not null)
                                {
                                    <form asp-action="Advance" method="post" class="d-inline">
                                        <input type="hidden" name="type" value="@r.Type" /><input type="hidden" name="id" value="@r.Id" />
                                        <input type="hidden" name="action" value="@next" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@next</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
