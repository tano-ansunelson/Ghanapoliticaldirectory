@inject IConfiguration Config
@{
    var nav = ViewData["Nav"] as string ?? "";
    var siteName = Config["Site:Name"] ?? "Ghana Political Directory";
    var showSample = Config.GetValue<bool>("Site:ShowSampleDataBanner");
    var title = ViewData["Title"] as string;
    var items = new (string Key, string Label, string Controller, string Action)[]
    {
        ("home", "Home", "Home", "Index"),
        ("presidency", "Presidency", "Presidency", "Index"),
        ("parliament", "Parliament", "Parliament", "Index"),
        ("elections", "Elections", "Elections", "Presidential"),
        ("parties", "Political Parties", "Parties", "Index"),
        ("ministries", "Ministries", "Ministries", "Index"),
        ("offices", "Government & Public Offices", "Ministries", "Offices"),
        ("archive", "History & Archives", "Archive", "Index"),
        ("about", "About", "Pages", "Show")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? "" : title + " · ")@siteName</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Political leaders, elections, ministries and administrations of Ghana in one searchable, sourced and neutral directory.")" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="gpd-body">
    <a class="gpd-skip" href="#main">Skip to main content</a>

    <div class="gpd-stripe" aria-hidden="true"><span></span><span></span><span></span></div>
    @if (showSample)
    {
        <div class="gpd-notice" role="note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Independent informational platform, not affiliated with any government body or political party.
            <strong>Prototype: all people, dates and figures are sample data.</strong>
        </div>
    }

    <header class="gpd-header">
        <div class="container gpd-header-top">
            <a class="gpd-brand" asp-controller="Home" asp-action="Index" aria-label="@siteName, home">
                <span class="gpd-brand-mark" aria-hidden="true">
                  <svg viewBox="0 0 36 36" width="36" height="36" focusable="false"><rect width="36" height="36" rx="8" fill="#0b5d3b" />
                    <polygon points="18,6 21.5,14.5 30.5,15 23.5,20.8 25.8,29.5 18,24.6 10.2,29.5 12.5,20.8 5.5,15 14.5,14.5" fill="#f2c230" />
                </svg>
                </span>
                <span>
                    <span class="gpd-brand-name">@siteName</span>
                    <span class="gpd-brand-tag">Leadership · Elections · Archives</span>
                </span>
            </a>

            <form class="gpd-search-compact d-none d-lg-flex" asp-controller="Search" asp-action="Index" method="get" role="search">
                <label for="hdr-q" class="visually-hidden">Search the directory</label>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="hdr-q" name="q" type="search" autocomplete="off" placeholder="Search people, parties, ministries…" data-suggest />
            </form>

            <a class="gpd-admin-link d-none d-lg-inline-flex" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-lock" aria-hidden="true"></i> Administrator login
            </a>

            <button class="navbar-toggler gpd-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Open menu">
                <i class="bi bi-list" aria-hidden="true"></i><span>Menu</span>
            </button>
        </div>

        <nav class="navbar navbar-expand-lg gpd-nav" aria-label="Main">
            <div class="container">
                <div class="collapse navbar-collapse" id="mainNav">
                    <form class="gpd-search-compact gpd-search-mobile d-lg-none" asp-controller="Search" asp-action="Index" method="get" role="search">
                        <label for="mob-q" class="visually-hidden">Search the directory</label>
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="mob-q" name="q" type="search" placeholder="Search the directory…" />
                    </form>
                    <ul class="navbar-nav">
                        @foreach (var item in items)
                        {
                            var current = item.Key == nav;
                            <li class="nav-item">
                                @if (item.Controller == "Pages")
                                {
                                    <a class="nav-link @(current ? "active" : "")" href="/about" aria-current="@(current ? "page" : null)">@item.Label</a>
                                }
                                else
                                {
                                    <a class="nav-link @(current ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action"
                                       aria-current="@(current ? "page" : null)">@item.Label</a>
                                }
                            </li>
                        }
                        <li class="nav-item d-lg-none">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-lock" aria-hidden="true"></i> Administrator login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="gpd-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="gpd-footer-brand">@siteName</div>
                    <p class="gpd-footer-note">
                        An independent informational platform. It is not operated by, or affiliated with, the Government of Ghana,
                        the Electoral Commission or any political party, unless formal authorisation is stated on the About page.
                        It does not conduct elections or accept votes. Official election results are those published by the Electoral Commission of Ghana.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="gpd-footer-h">Explore</h2>
                    <ul class="list-unstyled gpd-footer-links">
                        <li><a asp-controller="Presidency" asp-action="Index">Presidency</a></li>
                        <li><a asp-controller="Parliament" asp-action="Index">Parliament</a></li>
                        <li><a asp-controller="Elections" asp-action="Presidential">Elections</a></li>
                        <li><a asp-controller="Parties" asp-action="Index">Political Parties</a></li>
                        <li><a asp-controller="Ministries" asp-action="Index">Ministries</a></li>
                        <li><a asp-controller="Archive" asp-action="Index">History &amp; Archives</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="gpd-footer-h">About this site</h2>
                    <ul class="list-unstyled gpd-footer-links">
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/data-sources">Data Sources</a></li>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms of Use</a></li>
                        <li><a href="/corrections">Corrections</a></li>
                    </ul>
                </div>
            </div>
            <p class="gpd-footer-legal">© @DateTime.UtcNow.Year @siteName. Content is presented neutrally and does not rank or endorse any party or candidate.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
